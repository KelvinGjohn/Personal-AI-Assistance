# Copy this file to ".env" and fill in your own values.
# The real .env file is ignored by Git, so your secrets never reach GitHub.

# Flask settings
FLASK_ENV=development
# Generate one with:  py -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Database location (SQLite file, created automatically on Day 4)
DATABASE_URL=sqlite:///assistant.db

# AI provider
# AI_PROVIDER can be "fallback" (no real AI, clearly labelled) or "claude" (Anthropic API).
# For "claude", put your Anthropic API key in AI_API_KEY. Real answers cost money.
# Leave AI_MODEL empty to use the default model (claude-opus-5-5).
AI_PROVIDER=fallback
AI_API_KEY=
AI_MODEL=
